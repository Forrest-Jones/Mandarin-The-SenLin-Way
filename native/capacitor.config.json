{
  "appId": "com.senlinway.mandarin",
  "appName": "Mandarin The SenLin Way",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#fbfdf8"
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#fbfdf8",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_senlin",
      "iconColor": "#14a066",
      "sound": "default"
    },
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#14a066",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "CapacitorHttp": {
      "enabled": false
    }
  }
}
